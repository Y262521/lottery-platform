# Frontend environment variables. Copy to .env.local for local dev.
#
# VITE_API_BASE_URL — base URL of the backend API.
#   - Leave EMPTY for local dev (Vite proxies /api -> http://localhost:8000).
#   - On Vercel, set this to your Render backend URL, e.g.
#       VITE_API_BASE_URL=https://emerald-draw-api.onrender.com
#     (then also set the backend CORS_ORIGINS to your Vercel URL).
#   - If you instead use a Vercel rewrite to proxy /api to the backend, you can
#     leave this empty.
VITE_API_BASE_URL=
