# Copy to .env and adjust as needed. Secrets here are for LOCAL DEMO ONLY.
# Generate fresh values in production, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

SECRET_KEY=change-me-to-a-long-random-secret-9f8a7b6c5d4e3f2a1b0c9d8e7f6a5b4c
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

DATABASE_URL=sqlite:///./lottery.db

# First admin account created by the seeder
ADMIN_EMAIL=admin@lottery.local
ADMIN_PASSWORD=admin12345

# Wallet seed balance given to newly registered demo users (0 to disable)
SIGNUP_BONUS=100.00
